# Arche — every environment variable the server reads (validated by src/server/config/parse.ts). Copy to .env.local.
# Arche runs on PostgreSQL only. On a developer machine: `npm run db:local` creates the database, then `npm run db:migrate`.

# ── Database (required) ─────────────────────────────────────────────────────────────────────────────────────────────────
# Shared EPC2I server: postgres://arche_app:<ARCHE_APP_PASSWORD>@<host>:5432/epc2i (schema `arche`, created by Matrix).
DATABASE_URL=postgres://arche_app:arche-dev@127.0.0.1:5432/epc2i
# Connections per process (default 10).
DATABASE_POOL_MAX=
# Seed of an EMPTY schema at `npm run db:migrate`: demo (demonstration data set) or production (nothing but the record).
ARCHE_SEED=demo

# ── Sign-in ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# demo (default: "View as", never exposed without HTTP authentication) | entra (Microsoft Entra ID).
ARCHE_AUTH=
# ≥ 32 characters (entra).
ARCHE_SESSION_SECRET=
# Session lifetime in hours (default 12).
ARCHE_SESSION_HOURS=
# E-mails given the administrator role at their first sign-in (bootstrap of a new database), comma-separated.
ARCHE_ADMIN_EMAILS=
ENTRA_TENANT_ID=
ENTRA_ISSUER=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
ENTRA_POST_LOGOUT_REDIRECT_URI=

# ── Sibling applications (public URLs, inlined at build time) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_KEYSTONE_URL=
NEXT_PUBLIC_CODEX_URL=
NEXT_PUBLIC_VIGIE_URL=

# ── Operations ──────────────────────────────────────────────────────────────────────────────────────────────────────────
# Business clock: unset = the real date; "YYYY-MM-DD" pins it (demonstrations, tests).
ARCHE_CLOCK=
# Local files of this instance (default ./.data; /data in the image).
ARCHE_DATA_DIR=
# debug | info (default) | warn | error | silent ; json (production default) | pretty.
LOG_LEVEL=
LOG_FORMAT=
