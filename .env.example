# Arche — every environment variable the server reads (validated by src/server/config/parse.ts). Copy to .env.local.
# Arche runs on PostgreSQL only. On a developer machine: `npm run db:local` creates the database, then `npm run db:migrate`.

# ── Database (required) ─────────────────────────────────────────────────────────────────────────────────────────────────
# Shared EPC2I server: postgres://arche_app:<ARCHE_APP_PASSWORD>@<host>:5432/epc2i (schema `arche`, created by Matrix).
DATABASE_URL=postgres://arche_app:arche-dev@127.0.0.1:5432/epc2i
# Connections per process (default 10).
DATABASE_POOL_MAX=
# Seed of an EMPTY schema at `npm run db:migrate`: demo (demonstration data set) or production (nothing but the record).
ARCHE_SEED=demo

# ── Sign-in ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# demo (default: "View as", never exposed without HTTP authentication) | entra (Microsoft Entra ID).
ARCHE_AUTH=
# ≥ 32 characters (entra).
ARCHE_SESSION_SECRET=
# Session lifetime in hours (default 12).
ARCHE_SESSION_HOURS=
# E-mails given the administrator role at their first sign-in (bootstrap of a new database), comma-separated.
ARCHE_ADMIN_EMAILS=
ENTRA_TENANT_ID=
ENTRA_ISSUER=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
ENTRA_POST_LOGOUT_REDIRECT_URI=

# ── Sibling applications (public URLs, inlined at build time) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_KEYSTONE_URL=
NEXT_PUBLIC_CODEX_URL=
NEXT_PUBLIC_VIGIE_URL=

# ── Operations ──────────────────────────────────────────────────────────────────────────────────────────────────────────
# Business clock: unset = the real date; "YYYY-MM-DD" pins it (demonstrations, tests).
ARCHE_CLOCK=
# Local files of this instance (default ./.data; /data in the image).
ARCHE_DATA_DIR=
# debug | info (default) | warn | error | silent ; json (production default) | pretty.
LOG_LEVEL=
LOG_FORMAT=

# ── Matrix (data catalogue) ─────────────────────────────────────────────────────────────────────────────────────────────
# Arche declares its tables after each migration and at start-up; unset = nothing sent.
MATRIX_URL=
MATRIX_TOKEN=
# Optional: also writes the declaration to <dir>/arche.json.
MATRIX_DECLARATIONS_DIR=

# ── Codex (deposit of documents, CX-03) ──────────────────────────────────────────────────────────────────────────────
# Server URL of Codex; unset = NEXT_PUBLIC_CODEX_URL. Credentials in the URL (https://user:password@codex…) = the HTTP
# authentication of the host, sent as Basic.
CODEX_API_URL=
# Proofs of POST /api/documents, the same values as in Codex; neither = no deposit from Arche. The token uses the
# Authorization header: with credentials in CODEX_API_URL, use the secret (HMAC signature, ≥ 16 characters) instead.
CODEX_DOCUMENTS_TOKEN=
CODEX_DOCUMENTS_SECRET=
# "on" once Codex accepts the CAPEX attachment and the legal hold of a deposit (CX-01, CX-07); off by default.
CODEX_CAPEX=

# ── Keystone (machine catalogue, answers to the needs, EPC2i projects) ───────────────────────────────────────────────────
# off | simulation (default: demonstration data) | views (keystone.pub_* on the shared server; a missing view stays simulated).
ARCHE_KEYSTONE=
# Minutes between two synchronisations of the Keystone mirror by the worker (default 15).
ARCHE_KEYSTONE_SYNC_MIN=

# ── Backups (npm run worker / npm run backup) ──────────────────────────────────────────────────────────────────────────
# Folder of the pg_dump backups of the schema; unset = no scheduled backup.
ARCHE_BACKUP_DIR=
# Minutes between two backups (default 1440) and days kept (default 14).
ARCHE_BACKUP_EVERY_MIN=
ARCHE_BACKUP_RETENTION_DAYS=

# E-mail notifications of the circuits (AR-041): none (default: kept in the outbox, shown in Administration › Connectors) or
# file (one .eml per message in ARCHE_MAIL_DIR). SMTP or Microsoft Graph wait on the owner's choice (N-35).
ARCHE_MAIL_TRANSPORT=
ARCHE_MAIL_DIR=
ARCHE_MAIL_FROM=
# Origin of the links in the e-mails, e.g. https://arche.groupe.example
ARCHE_PUBLIC_URL=

# Sage connector (AR-047): folder of the planned extractions (<SUBSIDIARY>*.csv, moved to done/ once imported); unset: the
# controller uploads the extraction on the Sage import page.
ARCHE_SAGE_DIR=

# Advanced electronic signature of the G2 / AFE (AR-037, C-7): none (default: simple signature), simulation (a page of Arche
# stands for the provider; demonstrations) or yousign (key below; ARCHE_PUBLIC_URL required). Sandbox URL by default.
ARCHE_SIGNATURE_PROVIDER=
ARCHE_YOUSIGN_API_URL=
ARCHE_YOUSIGN_API_KEY=

# Vigie connector (AR-033): off, simulation (default: the demonstration data set only) or views (vigie.pub_etudes_securite,
# once Vigie publishes it and Matrix grants arche_app; a view not shared yet is simulated on the demonstration data set only).
ARCHE_VIGIE=
